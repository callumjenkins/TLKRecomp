static uint64_t rtl_apu_guest_cycle(void) {
====
/* TLK: true NTSC master clock and bsnes SPC700 rate (32040 * 768 / 24). */
#define TLK_NTSC_MASTER_HZ 21477272ull
/* Task O: the SPC rate is the emulated core's. bsnes v115 (BizHawk BSNESv115+)
 * runs it at 32040*768 Hz; bsnes v0.87 (BizHawk "BSNES", LibsnesCore, which
 * replays TAS 2716M) at 32040.5*768 = 24607104 Hz, i.e. 1025296 SPC cycles/s.
 * TLK_SPC_HZ overrides the default (1025280). */
#define TLK_SPC_HZ tlk_spc_hz()
static uint64_t tlk_spc_hz(void) {
  static uint64_t hz;
  if (!hz) { const char *e = getenv("TLK_SPC_HZ"); hz = e ? strtoull(e, NULL, 10) : 0; if (!hz) hz = 1025280ull; }
  return hz;
}
static uint64_t s_tlk_apu_origin_master;  /* g_cpu.master_cycles at host reset */
static uint64_t tlk_apu_cycle_at(uint64_t master) {
  uint64_t since = master >= s_tlk_apu_origin_master ? master - s_tlk_apu_origin_master : 0;
  return since * TLK_SPC_HZ / TLK_NTSC_MASTER_HZ;
}
/* Nearest SPC cycle: a CPU port write becomes visible to the SMP read that
 * samples mid-cycle (see apu-port-write-half-cycle). */
static uint64_t tlk_apu_write_cycle_at(uint64_t master) {
  uint64_t since = master >= s_tlk_apu_origin_master ? master - s_tlk_apu_origin_master : 0;
  return (since * TLK_SPC_HZ * 2 + TLK_NTSC_MASTER_HZ) / (2 * TLK_NTSC_MASTER_HZ);
}
static uint64_t rtl_apu_guest_cycle(void) {
