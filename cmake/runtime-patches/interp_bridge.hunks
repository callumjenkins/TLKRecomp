            sync_interp_to_cpu(&in,cpu);
            bridge_apu_flush(cpu);
            return 1;
        }
        /* TLK runtime patch: nested frame under an auto-quiescent scheduler. */
        if (!yield_pc && s_lle_sched_depth > 0 && s_interp_bridge_depth > 1 &&
            !s_sched_yield_pc && s_lle_master_deadline &&
            (cpu->master_cycles >= s_lle_master_deadline ||
