====
uint32_t tlk_snes_line_clocks(const Snes *snes, uint32_t v) { return snes_line_clocks(snes, v); }
int tlk_snes_short_field_get(void) { return s_short_field ? 1 : 0; }
void tlk_snes_short_field_set(int v) { s_short_field = v != 0; }
int tlk_snes_late_nmi_get(void) { return s_late_nmi ? 1 : 0; }
void tlk_snes_late_nmi_set(int v) { s_late_nmi = v != 0; }
