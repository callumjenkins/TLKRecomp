+def _upper_shards(pc_span: int) -> int:
+    return (0x8000 + pc_span - 1) // pc_span
+
+
+def _shard_part(pc16: int, pc_span: int) -> int:
+    """Shard index for an entry PC. $8000-$FFFF keeps the LoROM numbering
+    (part 00 starts at $8000); HiROM code below $8000 gets the parts after
+    those, instead of all landing in part 00."""
+    if pc16 >= 0x8000:
+        return (pc16 - 0x8000) // pc_span
+    return _upper_shards(pc_span) + pc16 // pc_span
+
+
+def _shard_start(part: int, pc_span: int) -> int:
+    upper = _upper_shards(pc_span)
+    if part < upper:
+        return 0x8000 + part * pc_span
+    return (part - upper) * pc_span
+
+
