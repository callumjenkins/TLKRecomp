# tlk_embed_assets(<target> <out.c> <dest>=<file> ...)
#
# Compiles files into <target> as a table runner/tlk_assets.c reads
# (g_tlk_assets: path, bytes, size), so a lone tlk_sdl.exe still has its
# shader presets and menu font. <dest> is the path under the asset folder,
# e.g. assets/fonts/LatoLatin-Regular.ttf. Generated at configure time; the
# files are configure dependencies, so editing one regenerates the table.
function(tlk_embed_assets target out)
    set(arrays "")
    set(rows "")
    set(i 0)
    foreach(pair IN LISTS ARGN)
        string(FIND "${pair}" "=" eq)
        string(SUBSTRING "${pair}" 0 ${eq} dest)
        math(EXPR from "${eq} + 1")
        string(SUBSTRING "${pair}" ${from} -1 file)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        file(SIZE "${file}" size)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND arrays "static const unsigned char a${i}[] = {${bytes}0};\n")
        string(APPEND rows "    { \"${dest}\", a${i}, ${size} },\n")
        math(EXPR i "${i} + 1")
    endforeach()
    set(src "/* Generated by cmake/TlkEmbedAssets.cmake. Do not edit. */\n#include <stddef.h>\n\n")
    string(APPEND src "typedef struct { const char *path; const unsigned char *data; size_t size; } TlkAsset;\n\n")
    string(APPEND src "${arrays}\nconst TlkAsset g_tlk_assets[] = {\n${rows}};\n")
    string(APPEND src "const size_t g_tlk_asset_count = ${i};\n")
    # Rewrite only on change, so an unchanged table doesn't recompile.
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL src)
        file(WRITE "${out}" "${src}")
    endif()
    target_sources(${target} PRIVATE "${out}")
endfunction()
