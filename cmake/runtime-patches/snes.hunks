file: runner/src/snes/snes.c

# Task I: NTSC short scanline. On a non-interlaced NTSC field with the field
# flag set, line 240 is 1360 master clocks instead of 1364 (bsnes
# Counter/lineclocks), so fields alternate 357368 and 357364 clocks (average
# 357366, which is what common_rtl.hunks maps the SPC clock against). The
# pinned beam always walks 1364, so every second field the CPU got 4 clocks
# bsnes does not have, and the CPU drifted 2 clocks per frame against the SPC
# (3,300 by poll 1660 of TAS 6987M). The field flag is host state (not in the
# frozen savestate blob): it starts long at power-on and flips at each V=0.
@@ short-line-state
<<<<
int snes_frame_counter;
====
int snes_frame_counter;
static bool s_short_field;  /* Task I: this field's line 240 is 1360 clocks */
static inline uint32_t snes_line_clocks(const Snes *snes, uint32_t v) {
  return (v == 240u && s_short_field && !(snes->ppu && PPU_interlace(snes->ppu)))
      ? 1360u : 1364u;
}
>>>>

@@ short-line-span
<<<<
    uint32_t span = 1364u - h;
====
    const uint32_t line_clocks = snes_line_clocks(snes, v);
    if (h >= line_clocks) h = line_clocks - 1u;  /* entered mid-line on a long field */
    uint32_t span = line_clocks - h;
>>>>

@@ short-line-irq-wrap
<<<<
        if (h >= 1364u) {
          h = 0; v++; if (v >= 262u) v = 0;
====
        if (h >= line_clocks) {
          h = 0; v++; if (v >= 262u) { v = 0; s_short_field = !s_short_field; }
>>>>

