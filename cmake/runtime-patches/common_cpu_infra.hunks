# Task M: exact AOT pacing (runner/aot_pace.c) needs the master clock at which
# the next DRAM refresh line is charged, to run its slow path at the same
# instruction boundary as the interpreter's per-opcode snes_refresh_charge().
# Export only; no behaviour change. Task N: follows task I's beam-position
# refresh (hunk below).
file: runner/src/common_cpu_infra.c

@@ refresh-next-export
<<<<
void snes_refresh_exempt(void) { g_refresh_charged_upto = g_cpu.master_cycles; }
====
void snes_refresh_exempt(void) { g_refresh_charged_upto = g_cpu.master_cycles; }
/* Task N: H position at master t and the length of that line, from the
 * beam. Compiled code walks the beam lazily, so t can lie a line before or
 * after the beam's last synced point; stepping across a line boundary uses
 * the real line length (short line 240, snes.hunks), not 1364, so the
 * refresh lands where the interpreter (beam synced every opcode) puts it. */
uint32_t tlk_snes_line_clocks(const Snes *snes, uint32_t v);
static uint64_t tlk_refresh_h_at(uint64_t t, uint64_t *line_len) {
  const uint64_t bml = g_snes->beamMasterLast;
  uint64_t h = g_snes->hPos;
  uint32_t v = g_snes->vPos;
  uint64_t len = tlk_snes_line_clocks(g_snes, v);
  if (t >= bml) {
    uint64_t d = t - bml;
    for (int i = 0; i < 4 && h + d >= len; i++) {
      d -= len - h; h = 0; v = v + 1u >= 262u ? 0u : v + 1u;
      len = tlk_snes_line_clocks(g_snes, v);
    }
    h = (h + d) % len;
  } else {
    uint64_t back = bml - t;
    for (int i = 0; i < 4 && back > h; i++) {
      back -= h; v = v ? v - 1u : 261u;
      len = tlk_snes_line_clocks(g_snes, v); h = len;
    }
    h = back <= h ? h - back : (h + 1364u - back % 1364u) % 1364u;
  }
  if (line_len) *line_len = len;
  return h;
}
static uint64_t tlk_refresh_to_next(uint64_t t) {
  uint64_t len;
  uint64_t h = tlk_refresh_h_at(t, &len);
  /* h == 538: the refresh at t was already taken, next one a line later. */
  return h < 538u ? 538u - h : len - h + 538u;
}
uint64_t tlk_refresh_next_master(void) {
  if (g_refresh_charged_upto == 0) return 0;
  if (g_snes) {
    /* Task I model (dram-refresh-at-beam-position): due at the next H=538
     * crossing after g_refresh_charged_upto. Report a few clocks early (an
     * early slow path only re-predicts). */
    uint64_t t = g_refresh_charged_upto;
    uint64_t r = t + tlk_refresh_to_next(t);
    return r > t + 8u ? r - 8u : t + 1u;
  }
  return g_refresh_charged_upto + (1364u - s_refresh_phase % 1364u);
}
