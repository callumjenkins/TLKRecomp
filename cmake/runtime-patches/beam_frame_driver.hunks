    if (snes_take_late_nmi() && g_snes->nmiEnabled &&
        g_cpu.master_cycles < frame_end) {
      s_wai_halted = false;
      g_snes->inNmi = true;
      run_interrupt(nmi_vector(), frame_end);
      g_snes->inNmi = false;
      continue;
    }
