+++ b/recompiler/v2/aot_pace.py	2026-10-12 06:45:17.596998749 -0600
@@ -289,3 +289,20 @@
                      f"((int)({cyc}) - {L + len(acc)}) : 0)")
     mc = " + ".join([f"{const}u"] + terms)
     return cyc, mc, not terms and not dyn_c
+
+
+def insn_bus_c(op: int, m: int, x: int, operand: int, code_spd: str):
+    """C expression for the master clocks of this instruction's bus bytes
+    (fetches + data/pointer/stack accesses, no internal cycles): where the
+    interpreter's s_interp_bus_master stands at its last access. Used to time
+    an APU-port access at its own bus cycle (task I). None without accesses."""
+    L = length(op, m, x)
+    _, _, acc = model(op, m, x, operand)
+    if not acc:
+        return None
+    try:
+        terms = [f"{L * int(code_spd)}u"]
+    except ValueError:
+        terms = [f"{L}u * ({code_spd})"]
+    terms += [f"aot_spd((uint32_t)({_c(a)}))" for a in acc]
+    return " + ".join(terms)
