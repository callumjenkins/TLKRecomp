# Task I: DRAM refresh once per scanline at its beam position.
#
# The pinned tax charges 40 clocks after every 1364 clocks of *other* time:
# the 40 it adds is excluded from the phase, so it fires every 1404 clocks
# (255 refreshes per 262-line frame instead of 262, ~300 free clocks a frame),
# and at an arbitrary point of the line. bsnes stalls the CPU 40 clocks when
# the beam passes H=538 (CPU rev 2) on every line. Where the stall lands
# decides which side of a CPU<->SPC handshake edge an access falls, so it
# feeds the lag-frame divergence against bsnes (INTEGRATE.md).
#
# Fix: take the H position of the last charged point from the beam
# (hPos + time since beamMasterLast) and charge 40 clocks for each H=538
# crossing up to now; the stall itself moves the beam, so successive
# refreshes are exactly one line apart. Without a beam (no g_snes) fall back to
# the old phase accumulator.

@@ dram-refresh-at-beam-position
<<<<
  uint64_t delta = m - g_refresh_charged_upto;
  s_refresh_phase += delta;
  uint64_t lines = s_refresh_phase / 1364u;
====
  uint64_t delta = m - g_refresh_charged_upto;
  if (g_snes && delta <= 4096u * 1364u) {
    uint64_t t = g_refresh_charged_upto;
    uint64_t end = m;
    /* Next H=538 crossing after t, from the beam (task N: tlk_refresh_to_next
     * steps across lines with their real length). */
    uint64_t to_next = tlk_refresh_to_next(t);
    while (t + to_next <= end) {
      t += to_next;
      end += 40u;          /* the stall delays everything after it */
      t += 40u;
      to_next = 1364u - 40u;
    }
    g_cpu.master_cycles = end;
    s_refresh_phase = 0;
    g_refresh_charged_upto = g_cpu.master_cycles;
    return;
  }
  s_refresh_phase += delta;
  uint64_t lines = s_refresh_phase / 1364u;
