  if (!booting && g_snes->nmiEnabled) {
    g_snes->inNmi = true;
>>>>

@@ late-nmi-deliver
<<<<
      if (interp_bridge_lle_took_wai())
        s_wai_halted = true;
    }
====
      if (interp_bridge_lle_took_wai())
        s_wai_halted = true;
