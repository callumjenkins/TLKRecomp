int spc_peekOpcodeCycles(Spc* spc) {
  if(spc->stopped) return 1;
  /* Code never runs from the I/O page; a read there has side effects. */
  if((spc->pc & 0xfff0) == 0x00f0) return 1;
  return cyclesPerOpcode[spc_read(spc, spc->pc)];
}

