# Task M: convert pending master clocks to SPC cycles with an exact integer
# ratio instead of a per-flush double product. Interpreted and generated code
# both feed s_apu_pending_master, but they flush it at different points (a
# nested interpreter frame flushes when it returns to compiled code), and
# summing pending*ratio in doubles over different chunkings made the SPC one
# cycle apart at the same master clock (l02_idle, frame 4: a $2140 poll loop
# exited one iteration early). floor(total_master * 1025280 / 21442080) is
# independent of chunking; the ratio is the same (32040*32)/(1364*262*60).
@@ aot-pace-apu-exact-ratio
<<<<
    g_snes->apuCatchupCycles += (double)s_apu_pending_master * kInterpApuPerMaster;
    g_apu_last_sync_master = cpu->master_cycles;
    snes_catchupApu(g_snes);
====
    { extern void (*g_aot_pace_flush_log)(uint64_t); if (g_aot_pace_flush_log) g_aot_pace_flush_log(s_apu_pending_master); }
    {
        static uint64_t s_tlk_apu_rem;  /* master x 1025280, not yet whole cycles */
        s_tlk_apu_rem += s_apu_pending_master * 1025280ull;
        uint64_t whole = s_tlk_apu_rem / 21442080ull;
        s_tlk_apu_rem -= whole * 21442080ull;
        g_snes->apuCatchupCycles += (double)whole;
    }
    g_apu_last_sync_master = cpu->master_cycles;
    snes_catchupApu(g_snes);
