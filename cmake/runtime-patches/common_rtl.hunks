# SPC700 guest clock for the frame-anchored APU timeline (non-extended path,
# which tlk_headless uses; the desktop host enables extended frame timing).
#
# The pinned runtime advances the SPC 17088 cycles per host frame and maps a
# within-frame master offset by 17088/357368, i.e. a 1,025,280 Hz SPC against a
# 21,442,080 Hz (1364*262*60) master clock. Real NTSC (and bsnes) runs the
# master at 21,477,272 Hz (357,366 clocks per frame on average), so the
# runtime's SPC ran 0.165% fast: ~2.9 frames of SPC time ahead of bsnes by
# frame 1789. It also restarted the mapping at each host frame's first
# master_cycles value, which sits a few to a few hundred clocks past the true
# field boundary (the CPU finishes its instruction, or owes clocks), so the
# SPC jittered against the CPU from frame to frame.
#
# That moved every CPU<->SPC handshake. TLK's command handshake
# ($C22388-$C22396, CMP $2141 / BNE) waited 1104 and 570 extra loop iterations
# on poll 1482 of TAS 6987M where bsnes waits none, the frame overran, and the
# game got a lag frame bsnes does not have (tools/compare_opcode_traces.py on
# the poll 1482 opcode traces; INTEGRATE.md).
#
# Fix: guest SPC time = (master clocks since host reset) * 1025280 / 21477272.
# The beam frame driver keeps g_cpu.master_cycles on the beam (it parks the
# clock at each field end), so this is the hardware clock in both tiers.
file: runner/src/common_rtl.c

@@ apu-guest-cycle-ntsc-ratio
<<<<
  uint64_t within = g_cpu.master_cycles - g_apu_frame_start_master;
  if (within >= RTL_MASTER_CYCLES_PER_FRAME)
    within = RTL_MASTER_CYCLES_PER_FRAME - 1;
  return (uint64_t)snes_frame_counter * RTL_APU_CYCLES_PER_FRAME +
         within * RTL_APU_CYCLES_PER_FRAME /
             RTL_MASTER_CYCLES_PER_FRAME;
}
