--- a/recompiler/v2/aot_pace.py
+++ b/recompiler/v2/aot_pace.py
@@ -0,0 +1,291 @@
+"""Exact interpreter-equivalent master-clock cost of one 65816 instruction.
+
+The LLE step loop (runner/src/snes/interp_bridge.c) charges every executed
+opcode as
+
+    master = sum(region_speed(a) for each bus access a) + 6 * max(0, cyc - n_bus)
+
+where the bus accesses are the opcode/operand fetches plus the data, pointer,
+stack and vector transfers the interpreter core (interp816.c) performs, and
+cyc is the core's cycle count (cyclesPerOpcode + its runtime adds). This
+module describes, per (opcode, m, x, operand), the same quantities as small
+expressions over the instruction's PRE-state, in a syntax that is valid both
+as C (after register renaming, see c_expr) and as Python (tests evaluate the
+model against the interpreter core itself).
+
+Expression vocabulary (pre-state):
+  D X Y S DB PB          registers (X/Y already 8-bit when x=1)
+  PEEK0(a)               byte at bank $00 address a (side-effect free)
+  PEEK(a24)              byte at 24-bit address (side-effect free)
+  XCROSS(base, idx)      1 if base+idx crosses a page from base, else 0
+  DPL                    1 if (D & 0xFF) != 0, else 0
+"""
+from __future__ import annotations
+
+# ── opcode table ─────────────────────────────────────────────────────────
+IMP, ACC, IMM_M, IMM_X, IMM8, DP, DPX, DPY, IDP, IDX, IDY, IDL, ILY, SR, ISY, \
+    ABS, ABX, ABY, ABL, ALX, REL, RLL, JIND, JIAX, JIAL, BM = range(26)
+
+_ALU = {0x00: 'ORA', 0x20: 'AND', 0x40: 'EOR', 0x60: 'ADC', 0x80: 'STA',
+        0xA0: 'LDA', 0xC0: 'CMP', 0xE0: 'SBC'}
+_ALU_MODES = {0x01: IDX, 0x03: SR, 0x05: DP, 0x07: IDL, 0x09: IMM_M, 0x0D: ABS,
+              0x0F: ABL, 0x11: IDY, 0x12: IDP, 0x13: ISY, 0x15: DPX, 0x17: ILY,
+              0x19: ABY, 0x1D: ABX, 0x1F: ALX}
+
+OPS: dict = {}
+for base, mn in _ALU.items():
+    for off, mode in _ALU_MODES.items():
+        OPS[base + off] = (mn, mode)
+OPS[0x89] = ('BIT', IMM_M)
+for base, mn in {0x00: 'ASL', 0x20: 'ROL', 0x40: 'LSR', 0x60: 'ROR'}.items():
+    OPS[base + 0x06] = (mn, DP); OPS[base + 0x0A] = (mn, ACC)
+    OPS[base + 0x0E] = (mn, ABS); OPS[base + 0x16] = (mn, DPX)
+    OPS[base + 0x1E] = (mn, ABX)
+OPS.update({
+    0xC6: ('DEC', DP), 0xCE: ('DEC', ABS), 0xD6: ('DEC', DPX), 0xDE: ('DEC', ABX),
+    0x3A: ('DEC', ACC), 0xE6: ('INC', DP), 0xEE: ('INC', ABS), 0xF6: ('INC', DPX),
+    0xFE: ('INC', ABX), 0x1A: ('INC', ACC),
+    0x04: ('TSB', DP), 0x0C: ('TSB', ABS), 0x14: ('TRB', DP), 0x1C: ('TRB', ABS),
+    0x24: ('BIT', DP), 0x2C: ('BIT', ABS), 0x34: ('BIT', DPX), 0x3C: ('BIT', ABX),
+    0x64: ('STZ', DP), 0x74: ('STZ', DPX), 0x9C: ('STZ', ABS), 0x9E: ('STZ', ABX),
+    0x84: ('STY', DP), 0x8C: ('STY', ABS), 0x94: ('STY', DPX),
+    0x86: ('STX', DP), 0x8E: ('STX', ABS), 0x96: ('STX', DPY),
+    0xA0: ('LDY', IMM_X), 0xA4: ('LDY', DP), 0xAC: ('LDY', ABS), 0xB4: ('LDY', DPX),
+    0xBC: ('LDY', ABX),
+    0xA2: ('LDX', IMM_X), 0xA6: ('LDX', DP), 0xAE: ('LDX', ABS), 0xB6: ('LDX', DPY),
+    0xBE: ('LDX', ABY),
+    0xC0: ('CPY', IMM_X), 0xC4: ('CPY', DP), 0xCC: ('CPY', ABS),
+    0xE0: ('CPX', IMM_X), 0xE4: ('CPX', DP), 0xEC: ('CPX', ABS),
+    0x08: ('PHP', IMP), 0x28: ('PLP', IMP), 0x48: ('PHA', IMP), 0x68: ('PLA', IMP),
+    0x8B: ('PHB', IMP), 0xAB: ('PLB', IMP), 0x0B: ('PHD', IMP), 0x2B: ('PLD', IMP),
+    0x4B: ('PHK', IMP), 0xDA: ('PHX', IMP), 0xFA: ('PLX', IMP), 0x5A: ('PHY', IMP),
+    0x7A: ('PLY', IMP), 0xF4: ('PEA', ABS), 0xD4: ('PEI', DP), 0x62: ('PER', RLL),
+    0x4C: ('JMP', ABS), 0x5C: ('JML', ABL), 0x6C: ('JMP', JIND), 0x7C: ('JMP', JIAX),
+    0xDC: ('JML', JIAL), 0x20: ('JSR', ABS), 0x22: ('JSL', ABL), 0xFC: ('JSR', JIAX),
+    0x60: ('RTS', IMP), 0x6B: ('RTL', IMP), 0x40: ('RTI', IMP),
+    0x00: ('BRK', IMM8), 0x02: ('COP', IMM8), 0x42: ('WDM', IMM8),
+    0x82: ('BRL', RLL), 0x80: ('BRA', REL),
+    0x10: ('BPL', REL), 0x30: ('BMI', REL), 0x50: ('BVC', REL), 0x70: ('BVS', REL),
+    0x90: ('BCC', REL), 0xB0: ('BCS', REL), 0xD0: ('BNE', REL), 0xF0: ('BEQ', REL),
+    0x54: ('MVN', BM), 0x44: ('MVP', BM),
+    0xC2: ('REP', IMM8), 0xE2: ('SEP', IMM8),
+})
+for op, mn in {0x18: 'CLC', 0x38: 'SEC', 0x58: 'CLI', 0x78: 'SEI', 0xB8: 'CLV',
+               0xD8: 'CLD', 0xF8: 'SED', 0xEA: 'NOP', 0xAA: 'TAX', 0xA8: 'TAY',
+               0x8A: 'TXA', 0x98: 'TYA', 0x9A: 'TXS', 0xBA: 'TSX', 0x9B: 'TXY',
+               0xBB: 'TYX', 0x5B: 'TCD', 0x7B: 'TDC', 0x1B: 'TCS', 0x3B: 'TSC',
+               0xE8: 'INX', 0xC8: 'INY', 0xCA: 'DEX', 0x88: 'DEY', 0xEB: 'XBA',
+               0xFB: 'XCE', 0xCB: 'WAI', 0xDB: 'STP'}.items():
+    OPS[op] = (mn, IMP)
+assert len(OPS) == 256, len(OPS)
+
+_READ = {'ORA', 'AND', 'EOR', 'ADC', 'LDA', 'CMP', 'SBC', 'BIT', 'LDX', 'LDY',
+         'CPX', 'CPY'}
+_WRITE = {'STA', 'STZ', 'STX', 'STY'}
+_RMW = {'ASL', 'ROL', 'LSR', 'ROR', 'DEC', 'INC', 'TSB', 'TRB'}
+_XWIDTH = {'LDX', 'LDY', 'CPX', 'CPY', 'STX', 'STY'}
+_DP_MODES = {DP, DPX, DPY, IDP, IDX, IDY, IDL, ILY}
+
+# Base cycles (interp816.c cyclesPerOpcode) and the core's static M/X adds,
+# measured from the core itself (TLKRecomp tools/aot_pace/verify.py --derive):
+# BASE[(op, m, x)].
+try:
+    from v2.aot_pace_table import BASE  # noqa: E402
+except ImportError:  # standalone (tests)
+    from aot_pace_table import BASE  # noqa: E402
+
+
+def length(op: int, m: int, x: int) -> int:
+    mn, mode = OPS[op]
+    if mode in (IMP, ACC):
+        return 1
+    if mode == IMM_M:
+        return 2 if m else 3
+    if mode == IMM_X:
+        return 2 if x else 3
+    if mode in (IMM8, DP, DPX, DPY, IDP, IDX, IDY, IDL, ILY, SR, ISY, REL):
+        return 2
+    if mode in (ABS, ABX, ABY, RLL, JIND, JIAX, JIAL, BM):
+        return 3
+    return 4  # ABL, ALX
+
+
+def _h(v: int) -> str:
+    return f"0x{v:X}"
+
+
+def model(op: int, m: int, x: int, operand: int):
+    """Return (static_cycles, dyn_cycle_exprs, data_addr_exprs).
+
+    data_addr_exprs are 24-bit address expressions, one per data/pointer/
+    stack/vector bus byte the interpreter core transfers (code fetches are
+    accounted separately by length()). dyn_cycle_exprs each evaluate to 0/1.
+    Taken-branch cycles are not included (the emitter charges them on the
+    taken edge)."""
+    mn, mode = OPS[op]
+    cyc = BASE[(op, m, x)]
+    dyn: list = []
+    acc: list = []
+    o = operand
+    wide = (not x) if mn in _XWIDTH else (not m)
+    n = 2 if wide else 1
+
+    def b0(e):  # bank-0 address expression
+        return f"(({e}) & 0xFFFF)"
+
+    def stack_push(k):
+        for i in range(k):
+            acc.append(b0(f"S - {i}"))
+
+    def stack_pull(k):
+        for i in range(k):
+            acc.append(b0(f"S + {i + 1}"))
+
+    if mode in _DP_MODES or mn == 'PEI':
+        dyn.append("DPL")
+
+    # Effective data addresses (lo, hi) for the memory modes.
+    ea = None  # list of 24-bit address exprs for the data bytes
+    if mn in _READ | _WRITE | _RMW and mode not in (IMM_M, IMM_X, ACC):
+        o8 = o & 0xFF
+        if mode == DP:
+            ea = [b0(f"D + {_h(o8)} + {i}") for i in range(n)]
+        elif mode == DPX:
+            ea = [b0(f"D + {_h(o8)} + X + {i}") for i in range(n)]
+        elif mode == DPY:
+            ea = [b0(f"D + {_h(o8)} + Y + {i}") for i in range(n)]
+        elif mode in (IDP, IDX, IDY, IDL, ILY, ISY):
+            if mode == IDX:
+                p = f"D + {_h(o8)} + X"
+            elif mode == ISY:
+                p = f"S + {_h(o8)}"
+            else:
+                p = f"D + {_h(o8)}"
+            nptr = 3 if mode in (IDL, ILY) else 2
+            for i in range(nptr):
+                acc.append(b0(f"{p} + {i}"))
+            ptr16 = f"(PEEK0({b0(p)}) | (PEEK0({b0(p + ' + 1')}) << 8))"
+            if mode in (IDL, ILY):
+                ptr = f"({ptr16} | (PEEK0({b0(p + ' + 2')}) << 16))"
+            else:
+                ptr = f"((DB << 16) + {ptr16})"
+            if mode in (IDY, ILY, ISY):
+                ea = [f"(({ptr} + Y + {i}) & 0xFFFFFF)" for i in range(n)]
+                if mode == IDY and mn in _READ:
+                    if x:
+                        dyn.append(f"XCROSS({ptr16}, Y)")
+            else:
+                ea = [f"(({ptr} + {i}) & 0xFFFFFF)" for i in range(n)]
+        elif mode == SR:
+            ea = [b0(f"S + {_h(o8)} + {i}") for i in range(n)]
+        elif mode == ABS:
+            ea = [f"(((DB << 16) + {_h(o & 0xFFFF)} + {i}) & 0xFFFFFF)" for i in range(n)]
+        elif mode in (ABX, ABY):
+            r = 'X' if mode == ABX else 'Y'
+            ea = [f"(((DB << 16) + {_h(o & 0xFFFF)} + {r} + {i}) & 0xFFFFFF)"
+                  for i in range(n)]
+            if mn in _READ and x:
+                dyn.append(f"XCROSS({_h(o & 0xFFFF)}, {r})")
+        elif mode == ABL:
+            ea = [f"(({_h(o & 0xFFFFFF)} + {i}) & 0xFFFFFF)" for i in range(n)]
+        elif mode == ALX:
+            ea = [f"(({_h(o & 0xFFFFFF)} + X + {i}) & 0xFFFFFF)" for i in range(n)]
+        else:
+            raise AssertionError((op, mode))
+        acc.extend(ea)
+        if mn in _RMW:
+            acc.extend(ea)  # write-back to the same bytes
+    elif mn in ('PHA', 'PHX', 'PHY'):
+        stack_push(2 if ((mn == 'PHA' and not m) or (mn != 'PHA' and not x)) else 1)
+    elif mn in ('PLA', 'PLX', 'PLY'):
+        stack_pull(2 if ((mn == 'PLA' and not m) or (mn != 'PLA' and not x)) else 1)
+    elif mn in ('PHB', 'PHK', 'PHP'):
+        stack_push(1)
+    elif mn in ('PLB', 'PLP'):
+        stack_pull(1)
+    elif mn == 'PHD':
+        stack_push(2)
+    elif mn == 'PLD':
+        stack_pull(2)
+    elif mn in ('PEA', 'PER'):
+        stack_push(2)
+    elif mn == 'PEI':
+        p = f"D + {_h(o & 0xFF)}"
+        acc.append(b0(p)); acc.append(b0(p + " + 1"))
+        stack_push(2)
+    elif mn == 'JSR' and mode == ABS:
+        stack_push(2)
+    elif mn == 'JSL':
+        stack_push(3)
+    elif mn == 'RTS':
+        stack_pull(2)
+    elif mn == 'RTL':
+        stack_pull(3)
+    elif mn == 'RTI':
+        stack_pull(4)
+    elif mn in ('BRK', 'COP'):
+        stack_push(4)
+        v = 0xFFE6 if mn == 'BRK' else 0xFFE4
+        acc.append(_h(v)); acc.append(_h(v + 1))
+    elif mode == JIND:
+        acc.append(_h(o & 0xFFFF)); acc.append(_h((o + 1) & 0xFFFF))
+    elif mode == JIAL:
+        for i in range(3):
+            acc.append(_h((o + i) & 0xFFFF))
+    elif mode == JIAX:
+        if mn == 'JSR':
+            stack_push(2)
+        acc.append(f"((PB << 16) | ((({_h(o & 0xFFFF)} + X) & 0xFFFF)))")
+        acc.append(f"((PB << 16) | ((({_h(o & 0xFFFF)} + X + 1) & 0xFFFF)))")
+    elif mode == BM:
+        dst, src = o & 0xFF, (o >> 8) & 0xFF
+        acc.append(f"(({_h(src)} << 16) | X)")
+        acc.append(f"(({_h(dst)} << 16) | Y)")
+    return cyc, dyn, acc
+
+
+# ── C rendering for the emitter ──────────────────────────────────────────
+import os as _os
+import re as _re
+
+ENABLED = _os.environ.get("SNESRECOMP_AOT_PACE", "1") != "0"
+
+_REG = _re.compile(r"\b(DB|PB|D|X|Y|S)\b")
+
+
+def _c(expr: str) -> str:
+    e = _REG.sub(lambda mo: f"cpu->{mo.group(1)}", expr)
+    e = e.replace("PEEK0(", "AOT_PEEK0(").replace("XCROSS(", "AOT_XCROSS(")
+    return _re.sub(r"\bDPL\b", "AOT_DPL", e)
+
+
+def insn_cost_c(op: int, m: int, x: int, operand: int, code_spd: str):
+    """C expressions (cycles, master clocks) for one executed instruction,
+    to be evaluated on the PRE-state. Returns (cyc_expr, mc_expr, static)
+    where static is True when both are compile-time constants."""
+    L = length(op, m, x)
+    c0, dyn, acc = model(op, m, x, operand)
+    internal = c0 - L - len(acc)
+    dyn_c = [_c(d) for d in dyn]
+    terms = []
+    try:
+        spd_const = int(code_spd)
+    except ValueError:
+        spd_const = None
+    const = 0
+    if spd_const is not None:
+        const += L * spd_const
+    else:
+        terms.append(f"{L}u * ({code_spd})")
+    for a in acc:
+        terms.append(f"aot_spd((uint32_t)({_c(a)}))")
+    if internal >= 0:
+        const += 6 * internal
+        terms += [f"6u * {d}" for d in dyn_c]
+        cyc = " + ".join([str(c0)] + dyn_c)
+    else:
+        cyc = " + ".join([str(c0)] + dyn_c)
+        terms.append(f"6u * (uint32_t)(((int)({cyc}) - {L + len(acc)}) > 0 ? "
+                     f"((int)({cyc}) - {L + len(acc)}) : 0)")
+    mc = " + ".join([f"{const}u"] + terms)
+    return cyc, mc, not terms and not dyn_c
