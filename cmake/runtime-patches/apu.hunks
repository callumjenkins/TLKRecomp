# Task I: anchor the CPU->SPC port timeline at the guest clock, not wherever
# the SPC happened to be at the first port write. Until that write the SPC is
# paced by the legacy relative catch-up, which in tlk_headless leaves it 4494
# SPC cycles (~0.26 frame) behind guest time (first write: guest 79914, SPC
# 75420). Every later port event kept that phase error, so the sound driver's
# timer ticks sat at a different point of each CPU frame than on hardware,
# where CPU and SMP leave reset together. On the first anchor, if the SPC is
# behind, map guest time 1:1 onto SPC cycles; the SPC then runs forward to the
# write's guest time before applying it.
@@ apu-port-anchor-at-guest-clock
<<<<
  if (!apu->portTimeValid || guest_cycle < apu->portLastGuest) {
    apu->portGuestAnchor = guest_cycle;
    apu->portTargetAnchor = apu->portClock;
    apu->portTimeValid = true;
====
  if (!apu->portTimeValid || guest_cycle < apu->portLastGuest) {
    const bool first = !apu->portTimeValid;
    apu->portGuestAnchor = guest_cycle;
    apu->portTargetAnchor = apu->portClock;
    if (first && apu->portClock < guest_cycle &&
        guest_cycle - apu->portClock < 65536u)  /* boot, not a state load */
      apu->portTargetAnchor = guest_cycle;
    apu->portTimeValid = true;
