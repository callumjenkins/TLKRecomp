# Task CC: --input-polled / --ram-log feed one tape word per pad read through an
# interpreter pre-opcode hook at the game's only pad read (`LDA $4218` at
# $C0A07C). Generated code never runs interpreter hooks, so once that read is
# compiled (the joypad routine $C0A05D, task CC) the tape stalled. A compiled
# read of $4218 now calls g_tlk_aot_pad_read_hook first (the interpreter's own
# read, inside its bus-timing window, is left to the pre-opcode hook).
@@ aot-pad-read-hook
<<<<
        uint64_t apu_t0 = tlk_aot_apu_enter(addr, 4);
        cpu_pace_cycles(addr);
====
        if (addr == 0x4218) {
            extern void (*g_tlk_aot_pad_read_hook)(void);
            extern int tlk_interp_bus_timing_active(void);
            if (g_tlk_aot_pad_read_hook && !tlk_interp_bus_timing_active())
                g_tlk_aot_pad_read_hook();
        }
        uint64_t apu_t0 = tlk_aot_apu_enter(addr, 4);
        cpu_pace_cycles(addr);
