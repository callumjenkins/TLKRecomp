====
int interp816_opcode_hook(uint32_t addr) { (void)addr; return 0; }

uint8_t tlk_bridge_read8(CpuState *cpu, uint32_t adr) {
    return bridge_bus_read(cpu, adr);
}
void tlk_bridge_write8(CpuState *cpu, uint32_t adr, uint8_t val) {
    bridge_bus_write(cpu, adr, val);
}
uint16_t tlk_bridge_read16(CpuState *cpu, uint32_t adrl, uint32_t adrh) {
    uint16_t v;
    if (bridge_bus_read_word(cpu, adrl, adrh, &v)) return v;
    const uint8_t lo = bridge_bus_read(cpu, adrl);
    return (uint16_t)(lo | bridge_bus_read(cpu, adrh) << 8);
}
void tlk_bridge_write16(CpuState *cpu, uint32_t adrl, uint32_t adrh,
                        uint16_t val, int reversed) {
    if (bridge_bus_write_word(cpu, adrl, adrh, val, reversed != 0)) return;
    if (reversed) {
        bridge_bus_write(cpu, adrh, (uint8_t)(val >> 8));
        bridge_bus_write(cpu, adrl, (uint8_t)val);
    } else {
        bridge_bus_write(cpu, adrl, (uint8_t)val);
        bridge_bus_write(cpu, adrh, (uint8_t)(val >> 8));
    }
}
/* Progress epochs as of the hook call; the step loop has just checkpointed. */
int tlk_bridge_hook_auto_quiescent(void) { return s_tlk_hook_auto_quiescent; }
uint64_t tlk_bridge_dynamic_epoch(void) { return s_interp_dynamic_progress_epoch; }
void tlk_bridge_op_begin(CpuState *cpu) {
    s_interp_bus_master = 0;
    s_interp_bus_cycles = 0;
    s_interp_bus_timing_active = 1;
    cpu->coprocessor_master_cycles = cpu->master_cycles;
}
/* Same statements, same order, as the step loop after interp816_runOpcode
 * (minus tier-2 coverage and diagnostics). */
void tlk_bridge_op_end(CpuState *cpu, int cyc, uint64_t *progress_write,
                       uint64_t *progress_dynamic) {
    s_interp_bus_timing_active = 0;
    if (cyc <= 0) cyc = 1;
    unsigned internal = (unsigned)cyc > s_interp_bus_cycles
                      ? (unsigned)cyc - s_interp_bus_cycles : 0;
    uint64_t master = s_interp_bus_master + (uint64_t)internal * 6u;
    { extern unsigned long long g_interp_bridge_steps; g_interp_bridge_steps++; }
    cpu->cycles        += (uint64_t)cyc;
    cpu->master_cycles += master;
    snes_refresh_charge();
    cpu->coprocessor_master_cycles = cpu->master_cycles;
    if (g_snes) snes_sync_master_clock(g_snes, cpu->master_cycles);
    if (g_snes && g_snes->cart)
        cart_sync_coprocessors(g_snes->cart, cpu->master_cycles);
#ifdef SNES_COSIM
    if (!cosim_apu_shared_clock())
#endif
    {
        if (rtl_apu_extended_frame_timing() ||
            !interp_bridge_use_absolute_apu_timeline(
                rtl_apu_frame_timeline_active(),
                g_snes && cart_has_sa1(g_snes->cart), false)) {
            s_apu_pending_master += master;
            if (s_apu_pending_master >= bridge_bounce_flush_thresh()) bridge_apu_flush(cpu);
        }
    }
    if (s_tlk_hook_auto_quiescent &&
        (*progress_write != g_interp_bridge_write_epoch ||
         *progress_dynamic != s_interp_dynamic_progress_epoch)) {
        *progress_write = g_interp_bridge_write_epoch;
        *progress_dynamic = s_interp_dynamic_progress_epoch;
        bridge_apu_flush(cpu);
    }
}
