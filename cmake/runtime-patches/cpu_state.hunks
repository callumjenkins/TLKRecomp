# Task M: exact AOT pacing. The interpreter walks the beam after every opcode,
# so a hardware register access always sees the beam at the master clock of
# the instruction start. Generated code walks it lazily (runner/aot_pace.c),
# so every hardware register touch first syncs the beam to the current master
# clock (a no-op on the interpreter path, already synced), and clears the AOT
# next-event cache (the access may change NMITIMEN/HTIME/VTIME or start DMA).
# APU-port touches also flush the interpreter's pending SPC catch-up first.
file: runner/src/cpu_state.c

@@ hw-touch-sync
<<<<
static inline void cpu_pace_cycles(uint16 addr) {
    g_main_cpu_cycles_estimate += 256;
====
static inline void cpu_pace_cycles(uint16 addr) {
    {
        extern uint64_t g_aot_pace_next;
        g_aot_pace_next = 0;
        if (g_snes) snes_sync_master_clock(g_snes, g_cpu.master_cycles);
        /* The interpreter flushes its pending APU master clocks before every
         * APU-port access; do it here for generated code (a no-op after the
         * interpreter's own flush). */
        if (addr >= 0x2140 && addr <= 0x217F) {
            extern void tlk_bridge_apu_flush(CpuState *cpu);
            tlk_bridge_apu_flush(&g_cpu);
        }
        extern void (*g_aot_pace_hw_log)(uint16 addr);
        if (g_aot_pace_hw_log) g_aot_pace_hw_log(addr);
    }
    g_main_cpu_cycles_estimate += 256;
