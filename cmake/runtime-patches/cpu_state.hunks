# Task N: task I times an interpreted APU-port access at its own bus cycle
# (interp_bridge.hunks apu-port-bus-time-*): a read 4 clocks before the end of
# its cycle, a write at the end, a 16-bit access by its low byte. Compiled
# code charges an instruction after its effects, so its port accesses ran at
# instruction start. Apply the same offset from g_aot_bus_mc (the bus clocks
# of the current compiled instruction, codegen patch 0004) unless the access
# comes from the interpreter, which has already applied it.
@@ aot-apu-port-bus-time-helpers
<<<<
static inline void cpu_pace_cycles(uint16 addr) {
====
static inline uint64_t tlk_aot_apu_enter(uint16 addr, uint32 lead) {
    extern int tlk_interp_bus_timing_active(void);
    extern uint32_t g_aot_bus_mc;
    if (addr < 0x2140 || addr > 0x217F || tlk_interp_bus_timing_active() ||
        g_aot_bus_mc < lead)
        return 0;
    uint64_t add = g_aot_bus_mc - lead;
    g_cpu.master_cycles += add;
    return add;
}
static inline void tlk_aot_apu_leave(uint64_t add) { g_cpu.master_cycles -= add; }
static inline void cpu_pace_cycles(uint16 addr) {
