# Task I: enabling NMI ($4200 bit 7, 0 -> 1) while the vblank NMI flag is still
# set (RDNMI not yet read) raises an NMI at once on hardware; the pinned
# runtime left this as a TODO and only ever delivered NMI at V=225. TLK ends
# each level load with NMI off and turns it back on wherever the load
# finishes. On 6987M poll 638 that is 39,000 clocks into vblank: bsnes takes
# the NMI there, the runtime waited a whole extra field, and the level started
# one frame late (one extra lag frame on every tape). Latch the request and arm
# an immediate interpreter deadline so the frame driver (beam_frame_driver.hunks)
# regains control at the next instruction boundary and delivers the NMI.
@@ late-nmi-latch
<<<<
      snes->nmiEnabled = val & 0x80;
      if(!snes->hIrqEnabled && !snes->vIrqEnabled) {
        snes->inIrq = false;
      }
====
      {
        const bool nmi_was_enabled = snes->nmiEnabled;
        snes->nmiEnabled = val & 0x80;
        if (!nmi_was_enabled && snes->nmiEnabled && snes->rdnmiPending &&
            snes->vPos >= 225u) {
          extern void interp_bridge_set_master_deadline(uint64_t master_clock);
          s_late_nmi = true;
          interp_bridge_set_master_deadline(1);  /* yield at the next boundary */
        }
      }
      if(!snes->hIrqEnabled && !snes->vIrqEnabled) {
        snes->inIrq = false;
      }
>>>>

@@ late-nmi-state
<<<<
static bool s_short_field;  /* Task I: this field's line 240 is 1360 clocks */
====
static bool s_short_field;  /* Task I: this field's line 240 is 1360 clocks */
static bool s_late_nmi;     /* Task I: NMI enabled mid-vblank with the flag set */
bool snes_take_late_nmi(void) {
  const bool pending = s_late_nmi;
  s_late_nmi = false;
  return pending;
}
