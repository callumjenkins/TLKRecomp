# TlkBuildId.cmake over a scratch tree: the id depends on the contents of the code and on the platform, never on
# mtimes or commits, and the version label follows git.
#   cmake -DSCRIPT=cmake/TlkBuildId.cmake -DWORK=DIR -P tests/tlk_build_id_test.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/src/runner" "${WORK}/src/cmake/runtime-patches" "${WORK}/gen" "${WORK}/rt/sub")
file(WRITE "${WORK}/rt/sub/rtl.c" "int rtl;\n")
file(WRITE "${WORK}/src/runner/a.c" "int a;\n")
file(WRITE "${WORK}/src/cmake/runtime-patches/x.hunks" "hunk\n")
file(WRITE "${WORK}/gen/f1.c" "one\n")
file(WRITE "${WORK}/gen/f2.c" "two\n")

set(PLATFORM Linux-x86_64)
function(build_id out_var)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DROOT=${WORK}/src -DGEN=${WORK}/gen -DRUNTIME=${WORK}/rt -DOUT=${WORK}/id.h
        -DPLATFORM=${PLATFORM} -P "${SCRIPT}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "TlkBuildId.cmake failed")
    endif()
    file(READ "${WORK}/id.h" text)
    set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

build_id(first)
string(REGEX MATCH "TLK_BUILD_ID [^\n]*" first_id "${first}")
if(NOT first MATCHES "^#define TLK_BUILD_ID \"[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-Linux-x86_64\"")
    message(FATAL_ERROR "unexpected header: ${first}")
endif()

file(REMOVE "${WORK}/id.h")
build_id(again)
if(NOT again STREQUAL first)
    message(FATAL_ERROR "a rebuild of the same files changed the id: ${first} then ${again}")
endif()

file(TIMESTAMP "${WORK}/id.h" stamp "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
file(TOUCH "${WORK}/gen/f1.c")
build_id(touched)
if(NOT touched STREQUAL first)
    message(FATAL_ERROR "a new mtime alone changed the id")
endif()
file(TIMESTAMP "${WORK}/id.h" restamp "%s")
if(NOT restamp STREQUAL stamp)
    message(FATAL_ERROR "an unchanged id rewrote the header, which recompiles everything that includes it")
endif()

file(WRITE "${WORK}/src/runner/a.c" "int a2;\n")
build_id(runner)
if(runner STREQUAL first)
    message(FATAL_ERROR "a changed runner file kept the id")
endif()
file(WRITE "${WORK}/src/runner/a.c" "int a;\n")

file(WRITE "${WORK}/rt/sub/rtl.c" "int rtl2;\n")
build_id(runtime)
if(runtime STREQUAL first)
    message(FATAL_ERROR "a changed snesrecomp runtime file kept the id")
endif()
file(WRITE "${WORK}/rt/sub/rtl.c" "int rtl;\n")

file(WRITE "${WORK}/gen/f2.c" "two!\n")
build_id(changed)
if(changed STREQUAL first)
    message(FATAL_ERROR "a changed generated file kept the id")
endif()

file(WRITE "${WORK}/gen/f2.c" "two\n")
file(WRITE "${WORK}/src/cmake/runtime-patches/x.hunks" "hunk2\n")
build_id(hunk)
if(hunk STREQUAL first)
    message(FATAL_ERROR "a changed runtime hunk kept the id")
endif()
file(WRITE "${WORK}/src/cmake/runtime-patches/x.hunks" "hunk\n")
set(PLATFORM Android-aarch64)
build_id(arm)
if(arm STREQUAL first)
    message(FATAL_ERROR "another platform kept the id")
endif()
set(PLATFORM Linux-x86_64)

# A commit that changes no code: the version moves, the id doesn't.
find_package(Git QUIET)
if(GIT_FOUND)
    set(git ${GIT_EXECUTABLE} -C ${WORK}/src -c user.name=t -c user.email=t@t -c commit.gpgsign=false)
    execute_process(COMMAND ${git} init -q)
    execute_process(COMMAND ${git} add -A)
    execute_process(COMMAND ${git} commit -qm one)
    build_id(committed)
    file(WRITE "${WORK}/src/README.md" "words\n")
    execute_process(COMMAND ${git} add -A)
    execute_process(COMMAND ${git} commit -qm two)
    build_id(recommitted)
    string(REGEX MATCH "TLK_BUILD_ID [^\n]*" id1 "${committed}")
    string(REGEX MATCH "TLK_BUILD_ID [^\n]*" id2 "${recommitted}")
    if(NOT id1 STREQUAL first_id OR NOT id2 STREQUAL id1)
        message(FATAL_ERROR "a commit with no code change moved the id: ${id1} then ${id2}")
    endif()
    if(committed STREQUAL recommitted)
        message(FATAL_ERROR "the version kept its label across a commit: ${committed}")
    endif()
endif()
message(STATUS "PASS")
