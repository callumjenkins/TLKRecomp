+// TLK task FF: pushed-frame calls whose continuation is decoded into the
+// calling routine (cfgs in SNESRECOMP_TLK_CFG_DIR):
+//   rts_call <site> return:<ret> [frame:N]  RTS / RTL / JML at <site> calls the
+//       pushed or named target; the routine continues at <ret>.
+//   rts_return <rts_site> return:<ret> via:<jmp_site>  `PEA <ret-1> / ... / JMP
+//       <body>` at <jmp_site>; the body's RTS at <rts_site> returns to <ret>.
+// The successor carries the site widths; the emitted goto checks the live
+// widths and falls back to the interpreter on any other M/X.
+fn tlk_cfg_continuations() -> &'static HashMap<u32, u32> {
+    static MAP: std::sync::OnceLock<HashMap<u32, u32>> = std::sync::OnceLock::new();
+    MAP.get_or_init(|| {
+        let mut m = HashMap::new();
+        if let Ok(dir) = std::env::var("SNESRECOMP_TLK_CFG_DIR") {
+            if let Ok(rd) = std::fs::read_dir(&dir) {
+                for ent in rd.flatten() {
+                    let p = ent.path();
+                    if p.extension().and_then(|e| e.to_str()) != Some("cfg") {
+                        continue;
+                    }
+                    let Ok(text) = std::fs::read_to_string(&p) else { continue };
+                    for line in text.lines() {
+                        let line = line.split('#').next().unwrap_or("");
+                        let t: Vec<&str> = line.split_whitespace().collect();
+                        if t.len() < 3 || !t[2].starts_with("return:") {
+                            continue;
+                        }
+                        let Ok(ret) = u32::from_str_radix(&t[2][7..], 16) else { continue };
+                        let site = if t[0] == "rts_call" {
+                            u32::from_str_radix(t[1], 16).ok()
+                        } else if t[0] == "rts_return" {
+                            t.iter()
+                                .find(|w| w.starts_with("via:"))
+                                .and_then(|w| u32::from_str_radix(&w[4..], 16).ok())
+                        } else {
+                            None
+                        };
+                        if let Some(site) = site {
+                            m.insert(site & 0xFFFFFF, ret & 0xFFFFFF);
+                        }
+                    }
+                }
+            }
+        }
+        m
+    })
+}
+
+fn tlk_rts_call_return(site_pc24: u32) -> Option<u32> {
+    tlk_cfg_continuations().get(&(site_pc24 & 0xFFFFFF)).copied()
+}
