# Task I: SPC700 opcodes take effect on their last base cycle, not their first.
#
# LakeSnes' apu_cycle runs a whole SPC opcode (all reads and writes) on the
# opcode's first cycle and then idles for the rest. On hardware (and bsnes)
# the data access is the last bus cycle: `MOV $F4,A` writes the CPU-visible
# port 3 cycles later, `MOV A,$F4` samples the CPU's port at its end. So every
# CPU<->SPC handshake round trip came out several SPC cycles short. TLK's
# streaming sample upload ($C21F84: CMP $2140 / BEQ, one pair per echo) ran
# ~15% faster per byte pair than in BizHawk (812-916 vs 956-1004 master clocks),
# moved more data per frame and changed which frames lag (6987M poll 1661).
#
# Fix: at an opcode boundary count down the opcode's base cycles and run it on
# the last one; a taken branch's extra cycles idle afterwards. Bit 7 of
# cpuCyclesLeft marks "counting down to execute" (opcodes take <= 12 cycles),
# so the frozen savestate layout is unchanged and old states still load.
file: runner/src/snes/apu.c

@@ apu-cycle-execute-on-last-cycle
<<<<
  if(apu->cpuCyclesLeft == 0) {
    /* Sample PC right BEFORE running the opcode — so PC reflects the
     * instruction we're about to execute, not the post-opcode PC. */
#if SNESRECOMP_SPC_DIAGNOSTICS
    g_spc_pc_histogram[apu->spc->pc]++;
    if (apu->spc->pc > g_spc_pc_max_seen) g_spc_pc_max_seen = apu->spc->pc;
#endif
    apu->cpuCyclesLeft = spc_runOpcode(apu->spc);
  }
  apu->cpuCyclesLeft--;
====
  if(apu->cpuCyclesLeft == 0) {
    int base = spc_peekOpcodeCycles(apu->spc);
    if (base < 1) base = 1;
    apu->cpuCyclesLeft = (uint8_t)(0x80 | base);
  }
  if(apu->cpuCyclesLeft & 0x80) {
    int base_left = apu->cpuCyclesLeft & 0x7f;
    if(base_left == 1) {
      int base = spc_peekOpcodeCycles(apu->spc);
      if (base < 1) base = 1;
      /* Sample PC right BEFORE running the opcode — so PC reflects the
       * instruction we're about to execute, not the post-opcode PC. */
#if SNESRECOMP_SPC_DIAGNOSTICS
      g_spc_pc_histogram[apu->spc->pc]++;
      if (apu->spc->pc > g_spc_pc_max_seen) g_spc_pc_max_seen = apu->spc->pc;
#endif
      int used = spc_runOpcode(apu->spc);
      int extra = used > base ? used - base : 0;
      apu->cpuCyclesLeft = (uint8_t)(extra + 1);
    }
  }
  apu->cpuCyclesLeft--;
  if(apu->cpuCyclesLeft == 0x80) apu->cpuCyclesLeft = 0;
>>>>

