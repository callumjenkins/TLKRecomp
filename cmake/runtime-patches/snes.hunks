      h = 0;
      v++;
      if (v == 225u) { snes->rdnmiPending = true; ppu_rasterFieldBoundary(); }
      if (v >= 262u) {
        v = 0;
====
    if (h >= line_clocks) {
      h = 0;
      v++;
      if (v == 225u) { snes->rdnmiPending = true; ppu_rasterFieldBoundary(); }
      if (v >= 262u) {
        v = 0;
        s_short_field = !s_short_field;
>>>>

@@ short-line-until-line
<<<<
  if (v == line && h == 0u) return 0;
  lines = (line > v) ? (line - v) : (262u - v + line);
  return lines * 1364u - h;
}
====
  if (v == line && h == 0u) return 0;
  lines = (line > v) ? (line - v) : (262u - v + line);
  {
    bool shortf = s_short_field;
    uint32_t total = 0, cur = v;
    for (uint32_t i = 0; i < lines; i++) {
      total += (cur == 240u && shortf && !(snes->ppu && PPU_interlace(snes->ppu))) ? 1360u : 1364u;
      if (++cur >= 262u) { cur = 0; shortf = !shortf; }
    }
    (void)lines;
    return total - h;
  }
}
