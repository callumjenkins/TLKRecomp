# Task I's interp-apu-flush-absolute-timeline is the same edit as task M's
# aot-pace-absolute-after-anchor above (kept once).

# Task I: an interpreted APU-port access happens at its own bus cycle, not at
# the start of the opcode. cpu->master_cycles is charged only after the opcode
# finishes, so the SPC was synced (reads) and the write was queued (writes) at
# opcode-start time: STA $2140 reached the SPC ~18 master clocks early, and
# every CPU<->SPC handshake round trip came out shorter than on bsnes. While
# a port access runs, offset master_cycles by the bus clocks this opcode has
# already spent (s_interp_bus_master, which includes the access itself). bsnes
# samples a read 4 clocks before the end of its bus cycle and commits a write at
# the end. A claimed 16-bit access is timed at its low byte, one 6-clock cycle
# before the high byte (the low byte carries the handshake in TLK's loops).
@@ apu-port-bus-time-helpers
<<<<
static void bridge_timing_bus(uint32_t adr) {
    if (!s_interp_bus_timing_active) return;
    s_interp_bus_cycles++;
    s_interp_bus_master+=bridge_region_speed(adr);
}
====
static void bridge_timing_bus(uint32_t adr) {
    if (!s_interp_bus_timing_active) return;
    s_interp_bus_cycles++;
    s_interp_bus_master+=bridge_region_speed(adr);
}

/* Returns the clocks added (0 = untouched); leave subtracts exactly that, so
 * any time charged during the access itself is kept. */
static uint64_t bridge_apu_time_enter(CpuState *cpu, int is_apu_port, unsigned lead) {
    if (!is_apu_port || !s_interp_bus_timing_active || s_interp_bus_master < lead)
        return 0;
    cpu->master_cycles += s_interp_bus_master - lead;
    return s_interp_bus_master - lead;
}
static void bridge_apu_time_leave(CpuState *cpu, uint64_t added) {
    cpu->master_cycles -= added;
}
