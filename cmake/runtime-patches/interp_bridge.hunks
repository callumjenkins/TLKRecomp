    int owner_is_scheduler;
    int bounce_recomp_base;
    uint32_t wlog_pc24;
    int apu_driving;
    int sched_owner_depth;
} TlkBridgeCtx;
size_t tlk_bridge_ctx_size(void) { return sizeof(TlkBridgeCtx); }
void tlk_bridge_ctx_save(void *buf) {
    TlkBridgeCtx *c = (TlkBridgeCtx *)buf;
    c->sched_depth = s_lle_sched_depth;
    c->sched_yield_pc = s_sched_yield_pc;
    c->sched_yield_flag_addr = s_sched_yield_flag_addr;
    c->sched_yield_flag_value = s_sched_yield_flag_value;
    c->unwind_active = s_lle_unwind_active;
    c->unwind_pc24 = s_lle_unwind_pc24;
    c->unwind_owner_depth = s_lle_unwind_owner_depth;
    c->unwind_is_deadline = s_lle_unwind_is_deadline;
    c->next_unwind_is_deadline = s_lle_next_unwind_is_deadline;
    c->bridge_depth = s_interp_bridge_depth;
    c->bounce_owner_depth = s_interp_bounce_owner_depth;
    c->owner_exit_s = s_interp_owner_exit_s;
    c->owner_exit_valid = s_interp_owner_exit_valid;
    c->owner_is_scheduler = s_interp_owner_is_scheduler;
    c->bounce_recomp_base = s_interp_bounce_recomp_base;
    c->wlog_pc24 = g_interp_wlog_pc24;
    c->apu_driving = g_interp_apu_driving;
    c->sched_owner_depth = s_tlk_sched_owner_depth;
}
void tlk_bridge_ctx_restore(const void *buf) {
    const TlkBridgeCtx *c = (const TlkBridgeCtx *)buf;
    s_lle_sched_depth = c->sched_depth;
    s_sched_yield_pc = c->sched_yield_pc;
    s_sched_yield_flag_addr = c->sched_yield_flag_addr;
    s_sched_yield_flag_value = c->sched_yield_flag_value;
    s_lle_unwind_active = c->unwind_active;
    s_lle_unwind_pc24 = c->unwind_pc24;
    s_lle_unwind_owner_depth = c->unwind_owner_depth;
    s_lle_unwind_is_deadline = c->unwind_is_deadline;
    s_lle_next_unwind_is_deadline = c->next_unwind_is_deadline;
    s_interp_bridge_depth = c->bridge_depth;
    s_interp_bounce_owner_depth = c->bounce_owner_depth;
    s_interp_owner_exit_s = c->owner_exit_s;
    s_interp_owner_exit_valid = c->owner_exit_valid;
    s_interp_owner_is_scheduler = c->owner_is_scheduler;
    s_interp_bounce_recomp_base = c->bounce_recomp_base;
    g_interp_wlog_pc24 = c->wlog_pc24;
    g_interp_apu_driving = c->apu_driving;
    s_tlk_sched_owner_depth = c->sched_owner_depth;
}
/* The suspended fiber's resume point, published like a deadline yield. */
void tlk_bridge_publish_resume(uint32_t pc24, uint16_t sp) {
    lle_resume_set(pc24 & 0xFFFFFFu, INTERP_RESUME_SITE_DEADLINE, sp);
}
void tlk_bridge_clear_next_unwind_deadline(void) { s_lle_next_unwind_is_deadline = 0; }
/* Nested interpreter frames under the scheduler (task H) yield here. */
int tlk_bridge_nested_yield_ok(void) {
    return s_lle_sched_depth > 0 && s_interp_bridge_depth > 1 && !s_sched_yield_pc &&
           s_lle_master_deadline != 0;
}

int tlk_fiber_run_until_quiescent(CpuState *cpu, uint32_t entry_pc24);  /* runner/tlk_fiber.c */
int interp_bridge_run_until_quiescent(CpuState *cpu, uint32_t entry_pc24) {
    return tlk_fiber_run_until_quiescent(cpu, entry_pc24);
}
