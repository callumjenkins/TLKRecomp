+def _tlk_rts_returns() -> Dict[int, List[int]]:
+    """TLK task FF: `rts_return <rts_site> return:<ret> via:<jmp_site>`: the
+    routine pushes <ret-1> and JMPs into a shared body whose RTS at <rts_site>
+    pops it. In a routine that has <ret> as a label, that RTS first checks the
+    live frame: popped == <ret-1> in the same bank -> pop and goto <ret> (what
+    the hardware does); anything else runs the normal RTS."""
+    global _TLK_RTS_RETURNS
+    if _TLK_RTS_RETURNS is None:
+        _TLK_RTS_RETURNS = {}
+        d = os.environ.get('SNESRECOMP_TLK_CFG_DIR')
+        if d:
+            for cfgp in sorted(pathlib.Path(d).glob('*.cfg')):
+                for line in cfgp.read_text().splitlines():
+                    t = line.split('#', 1)[0].split()
+                    if len(t) >= 3 and t[0] == 'rts_return' and t[2].startswith('return:'):
+                        _TLK_RTS_RETURNS.setdefault(int(t[1], 16) & 0xFFFFFF, []).append(
+                            int(t[2][7:], 16) & 0xFFFFFF)
+    return _TLK_RTS_RETURNS
+
+
+def _tlk_rts_return_lines(op, addr, local_labels) -> List[str]:
+    if not isinstance(op, Return) or op.long or op.interrupt or addr is None:
+        return []
+    site = addr & 0xFFFFFF
+    out = []
+    for ret in _tlk_rts_returns().get(site, []):
+        gotos = []
+        for m in (0, 1):
+            for x in (0, 1):
+                lab = f"L_{ret & 0xFFFF:04X}_M{m}X{x}"
+                if lab in local_labels:
+                    gotos.append(f"    if (cpu->m_flag == {m} && cpu->x_flag == {x}) {{ cpu->S = (uint16)(cpu->S + 2); goto {lab}; }}")
+        if not gotos:
+            continue
+        out += [
+            f"{{ /* TLK task FF: RTS at ${site:06X} through this routine's pushed frame -> ${ret:06X} */",
+            "  uint16 _rr = (uint16)(cpu_read8(cpu, 0x00, (uint16)(cpu->S + 1)) | (cpu_read8(cpu, 0x00, (uint16)(cpu->S + 2)) << 8));",
+            f"  if (cpu->PB == 0x{ret >> 16:02X} && _rr == 0x{(ret - 1) & 0xFFFF:04X}) {{",
+        ] + gotos + ["  }", "}"]
+    return out
+
+
+def _tlk_jml_call_lines(insn, local_labels) -> Optional[List[str]]:
+    """TLK task FF: `rts_call <site> return:<ret> frame:3` on a JML: the
+    routine pushed PHK / PEA <ret-1> and JMLs to a routine that RTLs through
+    that frame. Emitted as a call on the pushed frame plus a goto to the
+    compiled continuation (same as the RTS/RTL form)."""
+    from v2.lowering import LONG as _LONG_MODE
+    if getattr(insn, 'mnem', '') != 'JMP' or getattr(insn, 'mode', None) != _LONG_MODE:
+        return None
+    site = getattr(insn, 'addr', 0) & 0xFFFFFF
+    rc = _tlk_rts_calls().get(site)
+    if rc is None:
+        return None
+    ret, frame = rc
+    tgt = insn.operand & 0xFFFFFF
+    gotos = []
+    for m in (0, 1):
+        for x in (0, 1):
+            lab = f"L_{ret & 0xFFFF:04X}_M{m}X{x}"
+            if lab in local_labels:
+                gotos.append(f"  if (cpu->m_flag == {m} && cpu->x_flag == {x}) goto {lab};")
+    return [
+        f"{{ /* TLK task FF: pushed-frame JML call at ${site:06X} -> ${tgt:06X}, continuation ${ret:06X} */",
+        "  uint8 _rc_pb = cpu->PB;",
+        f"  cpu->PB = 0x{tgt >> 16:02X};",
+        f"  RecompReturn _rc_r = cpu_dispatch_call_pc_pushed(cpu, 0x{tgt:06x}u, 0x{site:06x}u, {frame}, NULL);",
+        "  cpu->PB = _rc_pb;",
+        "  if (_rc_r != RECOMP_RETURN_NORMAL) {",
+        "    cpu_trace_mark_nlr_exit(BD_EXIT_KIND_SKIP_PROPAGATION);",
+        "return (RecompReturn)((int)_rc_r - 1);",
+        "  }",
+    ] + gotos + [
+        f"return interp_tier_dispatch_balanced(cpu, 0x{ret:06x}u, 0x{site:06x}u, _entry_s, _hrv, false);",
+        "}",
+    ]
