# Task Q: compiled-code fibers (runner/tlk_fiber.c) keep a suspended compiled
# call chain alive on its own C stack while the frame driver runs interrupts
# and the next field on the host stack. The host-side call bookkeeping (the
# recomp call stack and its per-slot entry-S records, the tail-call return
# context, the interrupt-context depth) belongs to whichever stack is running,
# so the fiber module saves and restores it at every switch.

@@ fiber-call-context-export
<<<<
void RecompStackPop(void) { recomp_stack_pop_common(1); }
====
void RecompStackPop(void) { recomp_stack_pop_common(1); }

typedef struct TlkInfraCtx {
  int top;
  const char *stack[RECOMP_STACK_DEPTH];
  uint16_t entry_s[RECOMP_STACK_DEPTH];
  uint8_t entry_s_valid[RECOMP_STACK_DEPTH];
  uint8_t entry_return_frame[RECOMP_STACK_DEPTH];
  uint8_t entry_tailcall[RECOMP_STACK_DEPTH];
  uint8_t tc_valid;
  uint16_t tc_entry_s;
  uint8_t tc_hrv;
  unsigned irq_depth;
  const char *last;
  int wlog_slot;
  uint8_t hrv;
} TlkInfraCtx;
size_t tlk_infra_ctx_size(void) { return sizeof(TlkInfraCtx); }
void tlk_infra_ctx_save(void *buf) {
  TlkInfraCtx *c = (TlkInfraCtx *)buf;
  c->top = g_recomp_stack_top;
  memcpy(c->stack, g_recomp_stack, sizeof c->stack);
  memcpy(c->entry_s, g_cpu_entry_s, sizeof c->entry_s);
  memcpy(c->entry_s_valid, g_cpu_entry_s_valid, sizeof c->entry_s_valid);
  memcpy(c->entry_return_frame, g_cpu_entry_return_frame, sizeof c->entry_return_frame);
  memcpy(c->entry_tailcall, g_cpu_entry_tailcall, sizeof c->entry_tailcall);
  c->tc_valid = g_tailcall_context_valid;
  c->tc_entry_s = g_tailcall_entry_s;
  c->tc_hrv = g_tailcall_hrv;
  c->irq_depth = g_interrupt_context_depth;
  c->last = g_last_recomp_func;
  c->wlog_slot = g_wlog_aot_slot;
  c->hrv = g_cpu.host_return_valid;
}
void tlk_infra_ctx_restore(const void *buf) {
  const TlkInfraCtx *c = (const TlkInfraCtx *)buf;
  g_recomp_stack_top = c->top;
  memcpy(g_recomp_stack, c->stack, sizeof c->stack);
  memcpy(g_cpu_entry_s, c->entry_s, sizeof c->entry_s);
  memcpy(g_cpu_entry_s_valid, c->entry_s_valid, sizeof c->entry_s_valid);
  memcpy(g_cpu_entry_return_frame, c->entry_return_frame, sizeof c->entry_return_frame);
  memcpy(g_cpu_entry_tailcall, c->entry_tailcall, sizeof c->entry_tailcall);
  g_tailcall_context_valid = c->tc_valid;
  g_tailcall_entry_s = c->tc_entry_s;
  g_tailcall_hrv = c->tc_hrv;
  g_interrupt_context_depth = c->irq_depth;
  g_last_recomp_func = c->last;
  g_wlog_aot_slot = c->wlog_slot;
  g_cpu.host_return_valid = c->hrv;
}
int tlk_infra_tailcall_pending(void) { return g_tailcall_context_valid; }
