<<<<
int interp_bridge_run_until_quiescent(CpuState *cpu, uint32_t entry_pc24) {
====
typedef struct TlkBridgeCtx {
    int sched_depth;
    uint32_t sched_yield_pc;
    uint16_t sched_yield_flag_addr;
    uint8_t sched_yield_flag_value;
