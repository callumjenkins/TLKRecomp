diff --color -ruN a/recompiler/v2/codegen.py b/recompiler/v2/codegen.py
--- a/recompiler/v2/codegen.py	2026-10-12 12:31:03.375907415 -0600
+++ b/recompiler/v2/codegen.py	2026-10-12 12:31:11.799219966 -0600
@@ -2520,6 +2520,12 @@
         "#if SNESRECOMP_TRACE",
         f"  dbg_rts_trace(cpu, 0x{src24:06x}u, _entry_s, _ret_s, _rpc24, (uint8)_hrv);",
         "#endif",
+        # TLK task R: _hrv == 4 marks a body the interpreter entered at a
+        # JMP/JML target. Its own return (S back at entry) pops a frame the
+        # interpreter's routine owns: hand the popped PC back to it.
+        "  if (_hrv == 4 && _ret_s == _entry_s) {",
+        "    { extern uint32_t g_tlk_tail_ret_pc24; g_tlk_tail_ret_pc24 = _rpc24; }",
+        f"    return RECOMP_RETURN_NORMAL;  /* {label_inner} return to JMP-entering interpreter */ }}",
         f"  if (_hrv == {frame_sz} && _ret_s == _entry_s &&",
         "      _rpc24 != _host_return_pc24 && !cpu_dispatch_has_entry(cpu, _rpc24)) {",
         f"    return interp_tier_dispatch_rewritten_return(cpu, _rpc24, 0x{src24:06x}u);",
diff --color -ruN a/recompiler/v2/emit_function.py b/recompiler/v2/emit_function.py
--- a/recompiler/v2/emit_function.py	2026-10-12 12:31:03.376084524 -0600
+++ b/recompiler/v2/emit_function.py	2026-10-12 12:31:11.799694555 -0600
@@ -555,6 +555,10 @@
             "#if SNESRECOMP_TRACE",
             f"    dbg_rts_trace(cpu, 0x{pc24:06x}u, _entry_s, _ret_s, _rpc24, (uint8)_hrv);",
             "#endif",
+            "    if (_hrv == 4 && _ret_s == _entry_s) {",
+            "      { extern uint32_t g_tlk_tail_ret_pc24; g_tlk_tail_ret_pc24 = _rpc24; }",
+            "      RecompStackPop();",
+            "      return RECOMP_RETURN_NORMAL;  /* HLE RTS return to JMP-entering interpreter */ }",
             "    if (_hrv == 2 && _ret_s == _entry_s && _rpc24 == _host_return_pc24) {",
             "      RecompStackPop();",
             "      return RECOMP_RETURN_NORMAL;  /* HLE RTS host return */ }",
