# Nested interpreter frames hand interrupt waits outward under the beam driver.
#
# A compiled body that calls an interpreted routine runs it in a nested
# bridge frame (interp_tier_run_call_frame, yield_pc == 0). Under an
# auto-quiescent scheduler (beam_frame_driver / generic_frame_driver:
# interp_bridge_run_until_quiescent, yield_pc == 0xFFFFFFFE) only the
# outermost frame checks the master deadline and pending IRQs. A nested
# routine that spins until NMI/IRQ writes RAM (TLK $C21A47 on $1F00,
# $C537B2 on $0A0A) can never see the interrupt: the host is below it on the
# C stack. It runs to the step cap and bails.
#
# Fix: in such a nested frame, at the same instruction boundaries the
# outermost frame samples (deadline reached, or IRQ asserted with I clear),
# arm a deadline-class LLE unwind at the current PC and end the frame. The
# existing machinery carries it out: the tier helper re-emits the sentinel,
# every compiled callsite propagates it, and the scheduler frame's bounce site
# publishes the PC as the resume point and returns to the host. The guest
# stack holds every return address (paired-call ABI), so the host resumes
# interpreting exactly where the nested frame stopped, as --lle would.
# Only active while a deadline is armed and the owning scheduler is
# auto-quiescent (no explicit yield contract), so cooperative-scheduler games
# (MMX, SM) keep their own nested hand-off paths.
file: runner/src/snes/interp_bridge.c

@@ nested-auto-quiescent-handoff
<<<<
        if (auto_quiescent && s_lle_master_deadline &&
            cpu->master_cycles >= s_lle_master_deadline) {
            lle_resume_set(pc_before, INTERP_RESUME_SITE_DEADLINE, in.sp);
            sync_interp_to_cpu(&in,cpu);
            bridge_apu_flush(cpu);
            return 1;
        }
====
